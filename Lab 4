class Customer:
    def __init__(self, cid, cname, acc_no, balance, credit_card_no, transfer_funds, beneficiary_cust_object, amount):
        self.cid = cid
        self.cname = cname
        self.acc_no = acc_no
        self.balance = balance
        self.credit_card_no = credit_card_no
        self.transfer_funds = transfer_funds
        self.beneficiary_cust_object = beneficiary_cust_object
        self.amount = amount

    def display(self):
        print(f"cid: {self.cid}, cname: {self.cname}, acc_no: {self.acc_no}, balance: {self.balance}, credit_card_no {self.credit_card_no}, transfer_funds {self.transfer_funds}, beneficiary_cust_object {self.beneficiary_cust_object}, amount: {self.amount}")

class Card:
    def __init__(self, card_no, cvv, expiry_date, balance):
        self.card_no = card_no
        self.cvv = cvv
        self.expiry_date = expiry_date
        self.balance = balance
        

    def display(self):
        print(f"card_no: {self.card_no}, cvv: {self.cvv}, expiry_date: {self.expiry_date}, balance: {self.balance}")

