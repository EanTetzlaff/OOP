
class Customer:
    def __init__(self, cid, cname, acc_no, balance, credit_card_no):
        self.cid = cid
        self.cname = cname
        self.acc_no = acc_no
        self.balance = balance
        self.credit_card_no = credit_card_no

    def transfer_funds(self, beneficiary_object, amount):
        if self.balance < amount:
            self.balance -= amount
            beneficiary_object.balance += amount
            print("Balance Transfer Secussful")

    def display(self):
        print(f"cid: {self.cid}, cname: {self.cname}, acc_no: {self.acc_no}, balance: {self.balance}, credit_card_no {self.credit_card_no}")

class Card:
    def __init__(self, card_no, cvv, expiry_date, balance):
        self.card_no = card_no
        self.cvv = cvv
        self.expiry_date = expiry_date
        self.balance = balance

    def display(self):
        print(f"card_no: {self.card_no}, cvv: {self.cvv}, expiry_date: {self.expiry_date}, balance: {self.balance}")

