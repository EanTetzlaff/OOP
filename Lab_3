
class Book:
    def __init__(self, book_id, book_title, author_id, publisher, year_of_publication):
        self.book_id = book_id
        self.book_title = book_title
        self.author_id = author_id
        self.publisher = publisher
        self.year_of_publication = year_of_publication

    def display(self):
        print(f"Book ID: {self.book_id}, Title: {self.book_title}, Author ID: {self.author_id}, Publisher: {self.publisher}, Year {self.year_of_publication}")

class Author:
    def __init__(self, author_id, author_name, affiliation, country, phone, emailID):
        self.author_id = author_id
        self.author_name = author_name
        self.affiliation = affiliation
        self.country = country
        self.phone = phone
        self.emailID = emailID

    def display(self):
        print(f"Author ID: {self.author_id}, {self.author_name}, {self.affiliation}, {self.country}, {self.phone}, {self.emailID}")

class User:
    def __init__(self, user_id,name, password, address, phone, emailID):
        self.user_id = user_id
        self.name = name
        self.password = password
        self.address = address
        self.phone = phone
        self.emailID = emailID

    def display(self):
        print(f"User ID: {self.user_id}, Name: {self.name}, Address: {self.address}, Phone: {self.phone}, EmailID: {self.emailID}")

